# Copy to .env and fill it in. The .env file never goes to Git.
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=yourapppasswordwithoutspaces
# The LLM: fill in ONE of the two (see the README, "Connect an LLM")
# - Claude Pro/Max plan, provider "claude-code" (create it with: docker compose run --rm app claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# - an API key, provider "anthropic" or "openai-compatible" (Gemini, Groq, OpenAI, OpenRouter)
LLM_API_KEY=
# Folder with config.json, profile.md and the data
HIRELLME_DATA=./data